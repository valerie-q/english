<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Lesson 1 — Jobs in Tech</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink: #e8eaf0;
      --ink-soft: #b0b8cc;
      --paper: #12141a;
      --paper-dark: #1a1d26;
      --accent: #7c9ef5;
      --accent-light: #9bb3ff;
      --gold: #e8a838;
      --teal: #4a7fc1;
      --teal-light: #6b9fd4;
      --warm-grey: #7a84a0;
      --border: #2a2f3d;
      --white: #1e2230;
      --phase-1: #1e3a5f;
      --phase-2: #2a4a7a;
      --phase-3: #1a3a6e;
      --phase-4: #1e3a5f;
      --phase-5: #2a4a7a;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'DM Sans', sans-serif; background: var(--paper); color: var(--ink); line-height: 1.6; }

    .header { background: #0d0f14; color: var(--ink); padding: 48px 40px 40px; position: relative; overflow: hidden; }
    .header::before { content: ''; position: absolute; top: -60px; right: -60px; width: 280px; height: 280px; border-radius: 50%; background: radial-gradient(circle, rgba(124,158,245,0.15) 0%, transparent 70%); }
    .header::after { content: ''; position: absolute; bottom: -40px; left: 20%; width: 180px; height: 180px; border-radius: 50%; background: radial-gradient(circle, rgba(232,168,56,0.12) 0%, transparent 70%); }
    .header-inner { position: relative; z-index: 1; max-width: 1100px; margin: 0 auto; }
    .header h1 { font-family: 'Playfair Display', serif; font-size: clamp(36px, 5vw, 58px); font-weight: 900; line-height: 1.05; margin-bottom: 16px; }
    .header h1 em { font-style: italic; color: var(--accent-light); }
    .header-meta { display: flex; flex-wrap: wrap; gap: 24px; margin-top: 24px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.12); }
    .meta-chip { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,0.7); }
    .meta-chip .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }
    .meta-chip strong { color: var(--white); }

    .objectives-wrap { max-width: 1100px; margin: 0 auto; padding: 32px 40px; }
    .objectives-box { background: var(--white); border: 1px solid var(--border); border-left: 4px solid var(--gold); border-radius: 4px; padding: 24px 28px; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    @media (max-width: 700px) { .objectives-box { grid-template-columns: 1fr; } .header, .objectives-wrap, .main { padding-left: 20px; padding-right: 20px; } }
    .obj-col h3 { font-family: 'DM Mono', monospace; font-size: 11px; letter-spacing: 2.5px; text-transform: uppercase; color: var(--warm-grey); margin-bottom: 10px; }
    .obj-list { list-style: none; }
    .obj-list li { font-size: 14px; padding: 5px 0; padding-left: 18px; position: relative; color: var(--ink-soft); border-bottom: 1px dotted var(--border); }
    .obj-list li:last-child { border-bottom: none; }
    .obj-list li::before { content: '✓'; position: absolute; left: 0; color: var(--teal-light); font-size: 12px; font-weight: 600; }

    .main { max-width: 1100px; margin: 0 auto; padding: 0 40px 60px; }

    .phase { margin-bottom: 40px; border-radius: 6px; overflow: hidden; border: 1px solid var(--border); background: var(--white); box-shadow: 0 1px 4px rgba(0,0,0,0.04); }
    .phase-header { padding: 18px 24px; display: flex; align-items: center; gap: 16px; cursor: pointer; user-select: none; position: relative; }
    .phase-header::after { content: '▾'; position: absolute; right: 20px; font-size: 18px; color: rgba(255,255,255,0.6); transition: transform 0.3s; }
    .phase.collapsed .phase-header::after { transform: rotate(-90deg); }
    .phase-num { font-family: 'DM Mono', monospace; font-size: 11px; letter-spacing: 1.5px; background: rgba(255,255,255,0.18); padding: 4px 10px; border-radius: 20px; color: rgba(255,255,255,0.9); white-space: nowrap; }
    .phase-title { font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 700; color: var(--white); line-height: 1.2; }
    .phase-sub { font-size: 12px; color: rgba(255,255,255,0.65); margin-top: 2px; }
    .phase-time { margin-left: auto; margin-right: 32px; font-family: 'DM Mono', monospace; font-size: 13px; color: rgba(255,255,255,0.8); white-space: nowrap; background: rgba(0,0,0,0.2); padding: 4px 12px; border-radius: 20px; }
    .phase-body { padding: 0 24px 24px; }
    .phase.collapsed .phase-body { display: none; }
    .phase-1 .phase-header { background: var(--phase-1); }
    .phase-2 .phase-header { background: var(--phase-2); }
    .phase-3 .phase-header { background: var(--phase-3); }
    .phase-4 .phase-header { background: var(--phase-4); }
    .phase-5 .phase-header { background: var(--phase-5); }

    .activity { border: 1px solid var(--border); border-radius: 4px; margin-top: 16px; overflow: hidden; }
    .activity-head { background: #1a1d26; padding: 12px 16px; display: flex; align-items: center; gap: 12px; border-bottom: 1px solid var(--border); }
    .activity-icon { width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 15px; flex-shrink: 0; }
    .activity-title { font-weight: 600; font-size: 14px; color: var(--ink); }
    .activity-src { margin-left: auto; font-family: 'DM Mono', monospace; font-size: 10px; color: var(--warm-grey); background: #0d0f14; padding: 3px 8px; border-radius: 3px; white-space: nowrap; }
    .activity-time-badge { font-family: 'DM Mono', monospace; font-size: 10px; background: #0d0f14; color: var(--ink-soft); padding: 3px 8px; border-radius: 3px; white-space: nowrap; border: 1px solid var(--border); }
    .activity-body { padding: 16px; }

    .teacher-says { background: #1a2540; border-left: 3px solid #4a7fc1; border-radius: 0 4px 4px 0; padding: 12px 16px; margin: 12px 0; font-size: 14px; }
    .teacher-says .label { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: #6b9fd4; margin-bottom: 6px; }
    .teacher-says p { color: var(--ink-soft); line-height: 1.6; }
    .teacher-says em { font-style: italic; color: var(--ink); }
    .student-says { background: #1a2030; border-left: 3px solid var(--teal-light); border-radius: 0 4px 4px 0; padding: 12px 16px; margin: 8px 0; font-size: 14px; }
    .student-says .label { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--teal-light); margin-bottom: 6px; }
    .student-says p { color: var(--ink-soft); line-height: 1.6; }

    .vocab-table { width: 100%; border-collapse: collapse; font-size: 14px; margin: 12px 0; }
    .vocab-table th { background: #0d0f14; color: var(--ink); padding: 8px 12px; text-align: left; font-weight: 500; font-size: 12px; letter-spacing: 0.5px; }
    .vocab-table td { padding: 8px 12px; border-bottom: 1px solid var(--border); }
    .vocab-table tr:last-child td { border-bottom: none; }
    .vocab-table tr:nth-child(even) td { background: #1a1d26; }
    .vocab-table .eng { font-weight: 600; color: var(--ink); }
    .vocab-table .ans { color: var(--teal-light); font-style: italic; font-size: 13px; }

    .phrase-box { background: #0d0f14; color: #e8eaf0; border-radius: 4px; padding: 16px 20px; margin: 12px 0; border: 1px solid #2a2f3d; }
    .phrase-box .phrase-label { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 2.5px; text-transform: uppercase; color: var(--gold); margin-bottom: 10px; }
    .phrase-row { display: flex; align-items: baseline; gap: 16px; padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .phrase-row:last-child { border-bottom: none; }
    .phrase-en { font-size: 15px; font-weight: 500; flex: 1; color: #e8eaf0; }
    .phrase-de { font-size: 13px; color: #7a8cb0; flex: 1; }

    .tip-box { background: #1a2030; border: 1px solid #3a5080; border-radius: 4px; padding: 12px 16px; margin: 12px 0; font-size: 14px; display: flex; gap: 10px; }
    .tip-icon { font-size: 16px; flex-shrink: 0; }
    .tip-text { color: #a0b8d8; line-height: 1.5; }
    .tip-text strong { color: var(--ink); }

    .warn-box { background: #1f1a20; border: 1px solid #5a4060; border-radius: 4px; padding: 12px 16px; margin: 12px 0; font-size: 14px; color: #c0a0c8; display: flex; gap: 10px; }

    .steps { list-style: none; margin: 12px 0; }
    .steps li { display: flex; gap: 14px; padding: 10px 0; border-bottom: 1px dotted var(--border); font-size: 14px; line-height: 1.5; align-items: flex-start; }
    .steps li:last-child { border-bottom: none; }
    .step-num { font-family: 'DM Mono', monospace; font-size: 11px; font-weight: 500; color: var(--white); background: var(--ink-soft); width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px; }

    .answer-key { background: #1a1d26; border: 1px solid var(--border); border-radius: 4px; padding: 12px 16px; margin: 12px 0; font-size: 13px; }
    .answer-key .ak-label { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--warm-grey); margin-bottom: 8px; }
    .answer-key ol { padding-left: 20px; }
    .answer-key ol li { padding: 3px 0; color: var(--ink-soft); }
    .answer-key ol li strong { color: var(--teal); }

    .word-box { background: var(--white); border: 2px solid var(--teal); border-radius: 6px; padding: 12px 16px; margin: 12px 0; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .word-box-label { font-family: 'DM Mono', monospace; font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: var(--teal-light); width: 100%; margin-bottom: 4px; }
    .word-chip { background: #1e3a5f; color: #9bb3ff; font-size: 13px; font-weight: 600; padding: 4px 12px; border-radius: 20px; white-space: nowrap; border: 1px solid #2a4a7a; }
    .word-box.neutral { border-color: var(--border); }
    .word-box.neutral .word-chip { background: #252833; color: var(--ink-soft); border-color: var(--border); }

    .reveal-btn { font-family: 'DM Mono', monospace; font-size: 11px; letter-spacing: 1px; background: none; border: 1px solid var(--border); color: var(--warm-grey); padding: 5px 14px; border-radius: 20px; cursor: pointer; margin-top: 10px; transition: all 0.2s; }
    .reveal-btn:hover { border-color: var(--teal); color: var(--teal); }
    .reveal-content { display: none; margin-top: 10px; }
    .reveal-content.open { display: block; }

    .speaking-box { border: 2px solid var(--teal); border-radius: 6px; overflow: hidden; margin: 12px 0; }
    .speaking-box-header { background: #1e3a5f; padding: 10px 16px; display: flex; align-items: center; gap: 10px; }
    .speaking-box-header span { font-family: 'DM Mono', monospace; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: #9bb3ff; font-weight: 600; }
    .speaking-box-body { background: var(--white); padding: 16px; }
    .speaking-section { margin-bottom: 14px; }
    .speaking-section:last-child { margin-bottom: 0; }
    .speaking-section-title { font-size: 12px; font-weight: 700; color: var(--teal); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; font-family: 'DM Mono', monospace; }
    .speaking-row { display: flex; gap: 12px; padding: 5px 0; border-bottom: 1px dotted var(--border); font-size: 14px; }
    .speaking-row:last-child { border-bottom: none; }
    .speaking-q { flex: 1; color: var(--ink); }
    .speaking-a { flex: 1; color: var(--ink-soft); font-style: italic; }

    .match-table { width: 100%; border-collapse: collapse; font-size: 14px; margin: 12px 0; }
    .match-table th { background: #0d0f14; color: var(--ink); padding: 8px 12px; text-align: left; font-weight: 500; font-size: 12px; }
    .match-table td { padding: 8px 12px; border-bottom: 1px solid var(--border); vertical-align: top; }
    .match-table tr:last-child td { border-bottom: none; }
    .match-table tr:nth-child(even) td { background: #1a1d26; }
    .match-table .num { font-family: 'DM Mono', monospace; font-weight: 600; color: var(--accent-light); width: 30px; }

    .src-eft { background: #1e3a5f; color: #9bb3ff; border: 1px solid #2a4a7a; }
    .icon-warmup { background: #1a2030; }
    .icon-vocab { background: #1a2030; }
    .icon-grammar { background: #1f1e2a; }
    .icon-speaking { background: #1a2030; }
    .icon-wrap { background: #1a2030; }

    p { font-size: 14px; color: var(--ink-soft); line-height: 1.6; margin: 8px 0; }
    strong { color: var(--ink); }
    ol.exercise { padding-left: 20px; }
    ol.exercise li { font-size: 14px; color: var(--ink-soft); padding: 5px 0; border-bottom: 1px dotted var(--border); }
    ol.exercise li:last-child { border-bottom: none; }
    input[type="text"] { border: none; border-bottom: 1px solid var(--teal); background: transparent; font-family: 'DM Sans', sans-serif; font-size: 14px; color: var(--ink); outline: none; padding: 1px 4px; }
    input[type="text"]:focus { border-bottom-color: var(--accent); }
  </style>
</head>
<body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

<!-- HEADER -->
<div class="header">
  <div class="header-inner">
    <h1>Lesson 1<br><em>Jobs in Tech</em></h1>
    <div class="header-meta">
      <div class="meta-chip"><span class="dot"></span><strong>Level:</strong>&nbsp;B1–B2</div>
      <div class="meta-chip"><span class="dot"></span><strong>Textbook:</strong>&nbsp;English for Tech — Lesson 1</div>
      <div class="meta-chip"><span class="dot"></span><strong>Duration:</strong>&nbsp;60 min</div>
    </div>
  </div>
</div>

<!-- OBJECTIVES -->
<div class="objectives-wrap">
  <div class="objectives-box">
    <div class="obj-col">
      <h3>Goals</h3>
      <ul class="obj-list">
        <li>Discuss popular jobs in the tech industry</li>
        <li>Understand key vocabulary from the reading article</li>
        <li>Review Present Simple vs Present Continuous</li>
        <li>Practice pronouncing common tech job titles</li>
        <li>Write and deliver a personal elevator pitch</li>
      </ul>
    </div>
    <div class="obj-col">
      <h3>Language</h3>
      <ul class="obj-list">
        <li>Vocab: stakeholders, expertise, career path, from scratch, in a nutshell, optimize, specialize in</li>
        <li>Grammar: Present Simple (facts/routines) vs Present Continuous (now/temporary)</li>
        <li>Pitch phrases: I work as… / I help… / I'm in charge of… / Right now I am…</li>
        <li>Pronunciation: software developer, QA engineer, UI/UX designer, DevOps, architect</li>
      </ul>
    </div>
  </div>
</div>

<div class="main">

  <!-- ══ PHASE 1 ══ -->
  <div class="phase phase-1" id="ph1">
    <div class="phase-header" onclick="togglePhase('ph1')">
      <span class="phase-num">01</span>
      <div class="phase-title-wrap">
        <div class="phase-title">Warm-up — Tech jobs brainstorm</div>
      </div>
      <span class="phase-time">5 min</span>
    </div>
    <div class="phase-body">

      <div class="activity">
        <div class="activity-head">
          <div class="activity-icon icon-warmup">💬</div>
          <span class="activity-title">Discussion — What jobs exist in tech?</span>
          <span class="activity-time-badge">5 min</span>
        </div>
        <div class="activity-body">
          <div class="teacher-says">
            <div class="label">Teacher says</div>
            <p><em>"Let's start with a quick brainstorm. Without looking anything up — what tech job titles do you know in English? Let's list as many as we can."</em></p>
          </div>
          <p>After the student lists jobs, ask follow-up questions:</p>
          <ul class="steps">
            <li><span class="step-num">1</span><em>"Which of these jobs is closest to what you do?"</em></li>
            <li><span class="step-num">2</span><em>"Which job sounds most interesting to you — and why?"</em></li>
            <li><span class="step-num">3</span><em>"Have you ever worked with anyone in any of these roles?"</em></li>
          </ul>
          <div class="tip-box">
            <span class="tip-icon">🎯</span>
            <div class="tip-text">Мета цього етапу — активувати словниковий запас учня та зрозуміти його контекст перед текстом. Не виправляйте помилки — просто слухайте та запам'ятовуйте.</div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- ══ PHASE 2 ══ -->
  <div class="phase phase-2" id="ph2">
    <div class="phase-header" onclick="togglePhase('ph2')">
      <span class="phase-num">02</span>
      <div class="phase-title-wrap">
        <div class="phase-title">Reading — Popular Jobs in Tech</div>
        <div class="phase-sub">EfT Lesson 1 · pp. 12–16 · Ex. 1A, 1B, 2A, 2B, 2C, 3A, 3B</div>
      </div>
      <span class="phase-time">20 min</span>
    </div>
    <div class="phase-body">

      <!-- Ex 1A -->
      <div class="activity">
        <div class="activity-head">
          <div class="activity-icon icon-vocab">📖</div>
          <span class="activity-title">Ex. 1A — What does "from scratch" mean?</span>
          <span class="activity-src src-eft">EfT p.12</span>
          <span class="activity-time-badge">2 min</span>
        </div>
        <div class="activity-body">
          <p>Read the introduction paragraph aloud. Then answer:</p>
          <p style="margin-top: 10px;"><strong>What is the meaning of "from scratch"?</strong></p>
          <input type="text" size="50" placeholder="Your answer...">

          <button class="reveal-btn" onclick="toggleReveal('rev1')">show answer ▾</button>
          <div class="reveal-content" id="rev1">
            <div class="answer-key">
              <div class="ak-label">Answer</div>
              <ol>
                <li><strong>From scratch</strong> = з нуля / from the very beginning, without any prior knowledge or preparation</li>
              </ol>
            </div>
          </div>
        </div>
      </div>

      <!-- Ex 1B -->
      <div class="activity">
        <div class="activity-head">
          <div class="activity-icon icon-vocab">🔗</div>
          <span class="activity-title">Ex. 1B — Match jobs to descriptions</span>
          <span class="activity-src src-eft">EfT p.12</span>
          <span class="activity-time-badge">5 min</span>
        </div>
        <div class="activity-body">
          <p>Skim the article. Match each job title (1–5) with the correct description (a–e).</p>

          <div class="row g-3 mt-1">
            <div class="col-md-5">
              <table class="match-table">
                <thead><tr><th>#</th><th>Job title</th></tr></thead>
                <tbody>
                  <tr><td class="num">1</td><td>UX Writer</td></tr>
                  <tr><td class="num">2</td><td>Data Scientist</td></tr>
                  <tr><td class="num">3</td><td>Web Developer</td></tr>
                  <tr><td class="num">4</td><td>DevOps Engineer</td></tr>
                  <tr><td class="num">5</td><td>Blockchain Developer</td></tr>
                </tbody>
              </table>
            </div>
            <div class="col-md-7">
              <table class="match-table">
                <thead><tr><th>Letter</th><th>Description</th></tr></thead>
                <tbody>
                  <tr><td class="num">a</td><td>A person who creates the texts that appear in the interface of websites and apps.</td></tr>
                  <tr><td class="num">b</td><td>A person who designs and develops websites and web applications.</td></tr>
                  <tr><td class="num">c</td><td>An IT professional who oversees code releases and deployments and optimizes the development process.</td></tr>
                  <tr><td class="num">d</td><td>A person who builds applications based on blockchain architecture or protocols.</td></tr>
                  <tr><td class="num">e</td><td>A person who is responsible for collecting and analysing large data sets.</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <button class="reveal-btn" onclick="toggleReveal('rev2')">show answers ▾</button>
          <div class="reveal-content" id="rev2">
            <div class="answer-key">
              <div class="ak-label">Answer key</div>
              <ol>
                <li>1 → <strong>a</strong> — UX Writer creates interface texts</li>
                <li>2 → <strong>e</strong> — Data Scientist collects and analyses data</li>
                <li>3 → <strong>b</strong> — Web Developer designs and develops websites</li>
                <li>4 → <strong>c</strong> — DevOps Engineer oversees code releases</li>
                <li>5 → <strong>d</strong> — Blockchain Developer builds blockchain apps</li>
              </ol>
            </div>
          </div>
        </div>
      </div>

      <!-- Ex 2A — verbs -->
      <div class="activity">
        <div class="activity-head">
          <div class="activity-icon icon-vocab">✏️</div>
          <span class="activity-title">Ex. 2A — Complete phrases with verbs</span>
          <span class="activity-src src-eft">EfT p.15</span>
          <span class="activity-time-badge">5 min</span>
        </div>
        <div class="activity-body">
          <p>Complete each phrase using a verb from the box. Say each phrase aloud after filling it in.</p>

          <div class="word-box neutral">
            <div class="word-box-label">verb bank</div>
            <span class="word-chip">Collect</span>
            <span class="word-chip">Handle</span>
            <span class="word-chip">Keep up with</span>
            <span class="word-chip">Compete</span>
            <span class="word-chip">Specialize in</span>
            <span class="word-chip">Qualify</span>
            <span class="word-chip">Shorten</span>
            <span class="word-chip">Take on</span>
          </div>

          <ol class="exercise">
            <li><input type="text" size="18"> user data.</li>
            <li><input type="text" size="18"> for a job.</li>
            <li><input type="text" size="18"> with other people.</li>
            <li><input type="text" size="18"> a difficult task.</li>
